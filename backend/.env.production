# Backend Environment Variables - PRODUCTION
# Set these in Railway/Heroku/Render dashboard - DO NOT commit secrets!

# Database (Set in Railway postgres plugin - auto-populated)
DATABASE_URL=postgresql://user:password@host:5432/skillsync_ai

# Security
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=https://skillsync-ai.vercel.app,https://www.skillsync-ai.vercel.app

# Environment
ENVIRONMENT=production
DEBUG=false

# Email Configuration (Optional - for email verification)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@skillsync-ai.com

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
